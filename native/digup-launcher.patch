diff --git a/Sources/DigUpKit/LauncherLink.swift b/Sources/DigUpKit/LauncherLink.swift
new file mode 100644
index 0000000..98e6f73
--- /dev/null
+++ b/Sources/DigUpKit/LauncherLink.swift
@@ -0,0 +1,30 @@
+import Foundation
+
+/// A launcher hands the selected match back to the app, so the app's PDF, media and editor
+/// opening behavior stays in one place. The link contains metadata, never executable code.
+public struct LauncherLink: Sendable {
+    public let hit: SearchHit
+    public let query: String
+
+    public init?(url: URL) {
+        guard url.scheme == "digup", url.host == "open", url.absoluteString.count <= 65_536,
+              let components = URLComponents(url: url, resolvingAgainstBaseURL: false),
+              let encoded = components.queryItems?.first(where: { $0.name == "hit" })?.value,
+              let data = encoded.data(using: .utf8),
+              let fields = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+              let path = fields["path"] as? String, path.hasPrefix("/"), !path.contains("\0"),
+              let kindName = fields["kind"] as? String, let kind = FileKind(rawValue: kindName),
+              let segmentName = fields["segment"] as? String, let segment = SegmentKind(rawValue: segmentName)
+        else { return nil }
+        func number(_ key: String) -> Double? {
+            guard let value = fields[key] as? Double, value.isFinite, value >= 0, value <= 1_000_000_000 else { return nil }
+            return value
+        }
+        query = components.queryItems?.first(where: { $0.name == "query" })?.value ?? ""
+        hit = SearchHit(path: path, kind: kind, score: 0, z: nil, cosine: nil, keywordRank: nil,
+                        segment: segment, segmentID: (fields["segment_id"] as? NSNumber)?.int64Value ?? 0,
+                        loc: number("loc"), locEnd: number("loc_end"), excerpt: fields["excerpt"] as? String,
+                        modified: number("modified") ?? 0, size: (fields["size"] as? NSNumber)?.int64Value ?? 0,
+                        info: fields["info"] as? [String: String] ?? [:], focus: number("focus"))
+    }
+}
diff --git a/Tests/DigUpKitTests/LauncherLinkTests.swift b/Tests/DigUpKitTests/LauncherLinkTests.swift
new file mode 100644
index 0000000..57deff4
--- /dev/null
+++ b/Tests/DigUpKitTests/LauncherLinkTests.swift
@@ -0,0 +1,39 @@
+import Foundation
+import Testing
+@testable import DigUpKit
+
+struct LauncherLinkTests {
+    private func link(_ fields: [String: Any], query: String = "pets & dogs") throws -> URL {
+        let data = try JSONSerialization.data(withJSONObject: fields)
+        var url = URLComponents(string: "digup://open")!
+        url.queryItems = [URLQueryItem(name: "hit", value: String(data: data, encoding: .utf8)),
+                          URLQueryItem(name: "query", value: query)]
+        return url.url!
+    }
+
+    @Test func preservesLocationsAndUnicode() throws {
+        let url = try link(["path": "/Users/me/বাংলা #1 & lease.pdf", "kind": "pdf", "segment": "page",
+                            "segment_id": 42, "loc": 4.0, "excerpt": "the «pets» clause"])
+        let parsed = try #require(LauncherLink(url: url))
+        #expect(parsed.hit.path == "/Users/me/বাংলা #1 & lease.pdf")
+        #expect(parsed.hit.loc == 4)
+        #expect(parsed.hit.segmentID == 42)
+        #expect(parsed.query == "pets & dogs")
+    }
+
+    @Test func rejectsMalformedAndForeignLinks() throws {
+        #expect(LauncherLink(url: URL(string: "https://open?hit=no")!) == nil)
+        #expect(LauncherLink(url: URL(string: "digup://open?hit=bad")!) == nil)
+        #expect(LauncherLink(url: try link(["path": "relative.pdf", "kind": "pdf", "segment": "page"])) == nil)
+        #expect(LauncherLink(url: try link(["path": "/tmp/file", "kind": "bogus", "segment": "page"])) == nil)
+    }
+
+    @Test func invalidPositionsCannotReachTheOpener() throws {
+        let url = try link(["path": "/tmp/code.swift", "kind": "code", "segment": "lines",
+                            "loc": -99, "loc_end": 999_999_999_999.0, "focus": 12])
+        let parsed = try #require(LauncherLink(url: url))
+        #expect(parsed.hit.loc == nil)
+        #expect(parsed.hit.locEnd == nil)
+        #expect(parsed.hit.focus == 12)
+    }
+}
